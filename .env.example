# PrivateHSP local configuration
GOOGLE_CLOUD_PROJECT=project-aa91aa00-7576-4735-b60
GOOGLE_CLOUD_LOCATION=global
GEMINI_USE_VERTEX=true
# Configurable Vertex model; gemini-3.8-flash was verified with ADC in this project/location.
GEMINI_MODEL=gemini-3.8-flash

# HashKey Testnet (chain ID 133)
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_RPC_URL=https://testnet.hsk.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# Do not put private keys in NEXT_PUBLIC_* variables.
# Vertex uses ADC. Do not use API keys or service-account key files.

# Distinct local supplier identities are required before the offer API is enabled.
# Put real values only in ignored .env.local with restricted file permissions.
SUPPLIER_A_ADDRESS=
SUPPLIER_A_SIGNING_PRIVATE_KEY=
SUPPLIER_A_STEALTH_META_ADDRESS=
SUPPLIER_A_SPENDING_PRIVATE_KEY=
SUPPLIER_A_VIEWING_PRIVATE_KEY=
SUPPLIER_A_AMOUNT_BASE_UNITS=
SUPPLIER_B_ADDRESS=
SUPPLIER_B_SIGNING_PRIVATE_KEY=
SUPPLIER_B_STEALTH_META_ADDRESS=
SUPPLIER_B_SPENDING_PRIVATE_KEY=
SUPPLIER_B_VIEWING_PRIVATE_KEY=
SUPPLIER_B_AMOUNT_BASE_UNITS=
HASHKEY_TEST_TOKEN_ADDRESS=
HASHKEY_TEST_TOKEN_DECIMALS=

# Optional independent Ethereum Sepolia test environment (never HSP network config)
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Configure a funded public test wallet only after receiving explicit approval.
SEPOLIA_DEPLOYER_ADDRESS=
